<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:horizonos="http://schemas.horizonos/sdk"
    android:installLocation="auto">

    <horizonos:uses-horizonos-sdk
        horizonos:minSdkVersion="69"
        horizonos:targetSdkVersion="76" />

    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />
    <uses-feature android:glEsVersion="0x00030001" />
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-feature android:name="com.oculus.feature.VIRTUAL_KEYBOARD" android:required="false" />
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />

    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <!-- Exact front-door categories; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.oculus.intent.category.2D" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.oculus.intent.category.VR" />
        </intent>
        <!-- Players that can open a video the launcher hands them. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="video/*" />
        </intent>
        <package android:name="com.oculus.horizonmediaplayer" />
        <package android:name="com.oculus.hzosgallery" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/nexus_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest2|questpro|quest3|quest3s" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />
        <uses-native-library android:name="libossdk.oculus.so" android:required="true" />

        <activity
            android:name=".NexusActivity"
            android:excludeFromRecents="true"
            android:configChanges="screenSize|screenLayout|orientation|keyboardHidden|keyboard|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
            </intent-filter>
        </activity>

        <service
            android:name=".BackToLauncherService"
            android:description="@string/back_to_launcher_description"
            android:exported="true"
            android:label="@string/back_to_launcher_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/back_to_launcher_service" />
        </service>

        <!-- Only the ADB shell holds DUMP: Quest Fleet writes the menu here, per Android user. -->
        <provider
            android:name=".CatalogProvider"
            android:authorities="${applicationId}.catalog"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
